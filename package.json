{
  "name": "countercheck",
  "private": true,
  "description": "Open-source accounts-payable assistant: reads supplier invoices, checks them against purchase orders and goods receipts, and holds anything doubtful for a person.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "data": "uv run --project pipeline countercheck-data",
    "dev": "npm run dev --workspace @countercheck/web",
    "build": "npm run build --workspace @countercheck/web"
  },
  "overrides": {
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.0.0",
    "fast-check": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
