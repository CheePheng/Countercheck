{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Static assets (the app and the sample invoices) are served without running the Worker;
  // only /api/* reaches worker/index.ts: one metered model call per invoice read live.
  "name": "countercheck",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [{ "name": "METER", "class_name": "Meter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Meter"] }],
  // Bursts per visitor network; approximate and counted per Cloudflare location.
  "ratelimits": [
    { "name": "EXTRACT_LIMIT", "namespace_id": "1301", "simple": { "limit": 6, "period": 60 } }
  ],
  "vars": {
    // Workers AI's free allocation (10,000 neurons a day) is shared with other apps on the
    // account. Countercheck stays within its own cap, evals and recordings included.
    "DAILY_NEURON_CAP": "1500",
    // Held for one live reading (two attempts at most); the real cost is settled after.
    "CALL_RESERVE_NEURONS": "100",
    "VISITOR_CALLS_PER_DAY": "5",
    "LIVE_MODELS": "gemma-4",
    "LIVE": "on"
  },
  // No invocation logs, so request details such as visitor IP addresses aren't kept.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
